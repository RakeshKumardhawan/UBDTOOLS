<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup useLegacyV2RuntimeActivationPolicy="true"> 
        <!-- Support for .NET 4.x (4.0, 4.5, 4.6, 4.7, 4.8) -->
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
        <!-- Support for .NET 2.0 / 3.0 / 3.5 (CLR v2.0.50727) -->
        <supportedRuntime version="v2.0.50727" />
    </startup>
    <runtime>
        <!-- Security hardened runtime configuration -->
    </runtime>
    <appSettings>
        <add key="DepartmentProfile" value="Enterprise Portal" />
        <add key="TargetUrl" value="https://portal.internal.domain.com" />
        <add key="EnableAutoDiagnosticOnStartup" value="true" />
        <add key="DigiSignerPort" value="8080" />
    </appSettings>
</configuration>
